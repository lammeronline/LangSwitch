<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LangSwitch</AssemblyName>
    <RootNamespace>LangSwitch</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Flags\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LangSwitch.Core\LangSwitch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LangSwitch.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Bundled offline dictionaries for the flagship languages (en/ru/uk), so autocorrect works
    out of the box with no internet connection — everything else still downloads on demand
    when a matching keyboard layout is installed. Deliberately a Copy task, not a Content
    item: a Content item with CopyToOutputDirectory flows transitively to any project that
    references this one (including LangSwitch.Tests), which would pollute test runs with
    multi-MB real dictionaries instead of the tiny deterministic fixtures tests expect.
  -->
  <ItemGroup>
    <BundledWordLists Include="WordLists\*.dic;WordLists\*.aff" />
  </ItemGroup>

  <Target Name="CopyBundledWordListsToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(BundledWordLists)" DestinationFolder="$(OutDir)WordLists" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledWordListsToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(BundledWordLists)" DestinationFolder="$(PublishDir)WordLists" SkipUnchangedFiles="true" />
  </Target>

</Project>
